# backend/.env for the EC2 server. Copy to backend/.env ON THE SERVER and fill
# in every <...>. Never commit the real file.

DEBUG=False
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=<long random string>

# The server's public IP or DNS name (and later your domain), comma-separated.
ALLOWED_HOSTS=<EC2 public IP>,<EC2 public DNS name>
# Same addresses with http:// (https:// once HTTPS is on) — needed for admin login.
CSRF_TRUSTED_ORIGINS=http://<EC2 public IP>
# Where emailed links point (the site itself, since Nginx serves the frontend).
FRONTEND_URL=http://<EC2 public IP>
# Not needed in production: frontend and API share one address.
CORS_ALLOWED_ORIGINS=
USE_HTTPS=False

# RDS Postgres (from the RDS console: "Endpoint", master username/password).
POSTGRES_DB=campus_connect
POSTGRES_USER=<RDS master username>
POSTGRES_PASSWORD=<RDS master password>
POSTGRES_HOST=<RDS endpoint, e.g. xxx.us-east-1.rds.amazonaws.com>
POSTGRES_PORT=5432

# Redis isn't needed until chat; leave as-is.
REDIS_HOST=localhost
REDIS_PORT=6379

# Email: console = verification links appear in `journalctl -u gittogether`.
# Switch to SMTP (e.g. AWS SES) when real emails are set up.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Git Together <no-reply@gittogether.local>
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=<SES SMTP username>
# EMAIL_HOST_PASSWORD=<SES SMTP password>
# EMAIL_USE_TLS=True
