# backend/.env for the EC2 server. Copy to backend/.env ON THE SERVER and fill
# in every <...>. Never commit the real file.

DEBUG=False
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=<long random string>

# Domain(s) and the server's IP, comma-separated. Before the domain is set up,
# use just the IP. See docs/deploy.md, "Domain + HTTPS".
ALLOWED_HOSTS=datewithincampus.com,www.datewithincampus.com,<Elastic IP>
# Same names with https:// (http://<Elastic IP> before HTTPS) — needed for admin login.
CSRF_TRUSTED_ORIGINS=https://datewithincampus.com,https://www.datewithincampus.com
# Where emailed links point (the site itself, since Nginx serves the frontend).
FRONTEND_URL=https://datewithincampus.com
# Not needed in production: frontend and API share one address.
CORS_ALLOWED_ORIGINS=
# True once the Let's Encrypt certificate is installed.
USE_HTTPS=True

# RDS Postgres (from the RDS console: "Endpoint", master username/password).
POSTGRES_DB=campus_connect
POSTGRES_USER=<RDS master username>
POSTGRES_PASSWORD=<RDS master password>
POSTGRES_HOST=<RDS endpoint, e.g. xxx.us-east-1.rds.amazonaws.com>
POSTGRES_PORT=5432

# Redis on this same server (installed by setup-server.sh). Used by chat to
# deliver live messages between WebSocket connections.
REDIS_URL=redis://127.0.0.1:6379/0

# Email through AWS SES (docs/deploy.md, "Real email (AWS SES)").
# Before SES is set up, use the console backend instead: verification links
# then appear in `journalctl -u gittogether`:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email-smtp.us-east-2.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<SES SMTP username>
EMAIL_HOST_PASSWORD=<SES SMTP password>
DEFAULT_FROM_EMAIL=Git Together <no-reply@datewithincampus.com>
