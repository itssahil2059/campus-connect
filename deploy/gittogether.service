# systemd service: keeps Django (Daphne, an ASGI server) running and restarts
# it if it crashes or the server reboots. Installed by setup-server.sh to
# /etc/systemd/system/gittogether.service (deploy.sh re-copies it if changed).
#
#   sudo systemctl status gittogether      # is it running?
#   sudo systemctl restart gittogether     # after code changes (deploy.sh does this)
#   journalctl -u gittogether -f           # live logs, incl. verification emails
#
# Why Daphne instead of gunicorn: gunicorn's sync workers can only answer
# normal HTTP requests. Chat needs WebSockets (connections that stay open),
# which require an ASGI server. Daphne is Django Channels' own server and
# handles both regular API requests and WebSockets in one process.

[Unit]
Description=Git Together Django API + chat (Daphne)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/campus-connect/backend
# --proxy-headers: trust Nginx's X-Forwarded-For for the client IP.
# --access-log /dev/null: Nginx already logs every request, and Daphne's log
#   would include the chat login token from WebSocket URLs (?token=...).
ExecStart=/home/ubuntu/campus-connect/backend/.venv/bin/daphne \
    -b 127.0.0.1 -p 8000 --proxy-headers --access-log /dev/null \
    core.asgi:application
Restart=always

[Install]
WantedBy=multi-user.target
