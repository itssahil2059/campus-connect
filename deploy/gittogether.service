# systemd service: keeps Django (gunicorn) running and restarts it if it
# crashes or the server reboots. Installed by setup-server.sh to
# /etc/systemd/system/gittogether.service.
#
#   sudo systemctl status gittogether      # is it running?
#   sudo systemctl restart gittogether     # after code changes (deploy.sh does this)
#   journalctl -u gittogether -f           # live logs, incl. verification emails

[Unit]
Description=Git Together Django API (gunicorn)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/campus-connect/backend
# 2 workers suits a small (1–2 GB RAM) instance.
ExecStart=/home/ubuntu/campus-connect/backend/.venv/bin/gunicorn core.wsgi:application \
    --bind 127.0.0.1:8000 --workers 2 --access-logfile -
Restart=always

[Install]
WantedBy=multi-user.target
